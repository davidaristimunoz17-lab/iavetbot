# Motor de lenguaje: ollama | api | reglas
CEREBRO=ollama

# Ollama (por defecto)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b

# Endpoint compatible con OpenAI / Groq (solo si CEREBRO=api)
API_BASE=https://api.groq.com/openai/v1
API_KEY=
API_MODEL=llama-3.3-70b-versatile

# Telegram (solo si --canal telegram)
TELEGRAM_TOKEN=
TELEGRAM_ADMINS=123456789

# Límites del canal
MAX_MENSAJES_POR_MINUTO=10
MAX_CARACTERES=1500
